#!/usr/bin/env bash
# Haalt de nieuwste release van GitHub op en zet die klaar.
# Draait als root via eee-update.timer. Met --nu wordt niet eerst willekeurig gewacht.
#
# Werking:
#   1. vraag de nieuwste release op via de GitHub-API
#   2. download de binary voor deze processor en het sha256-bestand
#   3. controleer de checksum en of de binary start (--version)
#   4. zet hem in /opt/eee/releases/<versie> en wijs /opt/eee/huidig ernaar
#   5. de vorige versie blijft staan; bij een fout blijft alles zoals het was
set -euo pipefail

CONF=/etc/eee/update.conf
REPO=""; GITHUB_TOKEN=""; KANAAL="stable"
[[ -f "$CONF" ]] && . "$CONF"
[[ -f /etc/eee/geheimen.env ]] && . /etc/eee/geheimen.env
[[ -n "$REPO" && "$REPO" != "OWNER/REPO" ]] || { echo "Geen REPO ingesteld in $CONF"; exit 0; }

[[ "${1:-}" == "--nu" ]] || sleep $((RANDOM % 60))

case "$(uname -m)" in
  i?86) ARCH=386 ;;
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv6l) ARCH=arm ;;
  *) echo "Onbekende processor $(uname -m)"; exit 1 ;;
esac

AUTH=()
[[ -n "$GITHUB_TOKEN" ]] && AUTH=(-H "Authorization: Bearer $GITHUB_TOKEN")

if [[ "$KANAAL" == "stable" ]]; then
  API="https://api.github.com/repos/$REPO/releases/latest"
else
  API="https://api.github.com/repos/$REPO/releases?per_page=1"
fi
INFO="$(curl -fsSL "${AUTH[@]}" -H "Accept: application/vnd.github+json" "$API")" || { echo "GitHub niet bereikbaar"; exit 0; }
[[ "$KANAAL" == "stable" ]] || INFO="$(jq '.[0]' <<<"$INFO")"

VERSIE="$(jq -r '.tag_name' <<<"$INFO")"
[[ -n "$VERSIE" && "$VERSIE" != "null" ]] || { echo "Geen release gevonden"; exit 0; }

HUIDIG="$(readlink -f /opt/eee/huidig 2>/dev/null | xargs -r basename || true)"
if [[ "$HUIDIG" == "$VERSIE" ]]; then
  echo "Al bijgewerkt ($VERSIE)"; exit 0
fi

asset_url() { jq -r --arg n "$1" '.assets[] | select(.name==$n) | .url' <<<"$INFO"; }
BIN_URL="$(asset_url "eee-linux-$ARCH")"
SUM_URL="$(asset_url "eee-linux-$ARCH.sha256")"
[[ -n "$BIN_URL" && -n "$SUM_URL" ]] || { echo "Release $VERSIE heeft geen bestand voor $ARCH"; exit 1; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
haal() { curl -fsSL "${AUTH[@]}" -H "Accept: application/octet-stream" -o "$2" "$1"; }
haal "$BIN_URL" "$TMP/eee"
haal "$SUM_URL" "$TMP/eee.sha256"

VERWACHT="$(awk '{print $1}' "$TMP/eee.sha256")"
GEMETEN="$(sha256sum "$TMP/eee" | awk '{print $1}')"
[[ "$VERWACHT" == "$GEMETEN" ]] || { echo "Checksum klopt niet, update afgebroken"; exit 1; }

chmod 0755 "$TMP/eee"
"$TMP/eee" --version >/dev/null || { echo "Nieuwe versie start niet, update afgebroken"; exit 1; }

install -d "/opt/eee/releases/$VERSIE"
install -m 0755 "$TMP/eee" "/opt/eee/releases/$VERSIE/eee"
[[ -n "$HUIDIG" ]] && ln -sfn "/opt/eee/releases/$HUIDIG" /opt/eee/vorige
ln -sfn "/opt/eee/releases/$VERSIE" /opt/eee/huidig.nieuw
mv -Tf /opt/eee/huidig.nieuw /opt/eee/huidig
ln -sfn /opt/eee/huidig/eee /usr/local/bin/eee

# alleen de laatste drie versies bewaren
ls -1dt /opt/eee/releases/*/ 2>/dev/null | tail -n +4 | xargs -r rm -rf

echo "Bijgewerkt naar $VERSIE. Actief na de volgende herstart van de app."
