#!/usr/bin/env bash
# Fetches the latest release from GitHub and installs it.
# Runs as root from unscroll-update.timer. With --nu it skips the random initial wait.
#
# Steps:
#   1. ask the GitHub API for the latest release
#   2. download the binary for this processor and its sha256 file
#   3. verify the checksum and that the binary starts (--version)
#   4. put it in /opt/unscroll/releases/<version> and point /opt/unscroll/huidig at it
#   5. the previous version stays; on any error nothing changes
#   6. the scripts (session, updater, parent helper) come along when the release has them
set -euo pipefail

CONF=/etc/unscroll/update.conf
REPO=""; GITHUB_TOKEN=""; KANAAL="stable"
# shellcheck source=/dev/null
[[ -f "$CONF" ]] && . "$CONF"
# shellcheck source=/dev/null
[[ -f /etc/unscroll/geheimen.env ]] && . /etc/unscroll/geheimen.env
[[ -n "$REPO" && "$REPO" != "OWNER/REPO" ]] || { echo "No REPO set in $CONF"; exit 0; }

# Repair: older installers created ~/.config of the child as root, so the app could
# not save its settings there. Cheap to check on every run.
KIND="${KIND:-kind}"
if [[ -d "/home/$KIND/.config" ]] && [[ "$(stat -c %U "/home/$KIND/.config")" != "$KIND" ]]; then
  chown "$KIND:$KIND" "/home/$KIND/.config" && echo "Fixed the owner of /home/$KIND/.config"
fi

# Keep playing with the lid closed and keep wifi awake: the default lid action is suspend,
# and wifi power saving drops streams (an audiobook then stops). Written only when different.
zet_conf() {     # zet_conf file content reload-command...
  local f=$1 inhoud=$2; shift 2
  if [[ "$(cat "$f" 2>/dev/null)" != "$inhoud" ]]; then
    mkdir -p "$(dirname "$f")" && printf '%s\n' "$inhoud" > "$f" && "$@" >/dev/null 2>&1 || true
    echo "Updated $f"
  fi
}
zet_conf /etc/systemd/logind.conf.d/unscroll.conf "$(printf '[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\nIdleAction=ignore')" \
  systemctl kill -s HUP systemd-logind
zet_conf /etc/NetworkManager/conf.d/unscroll-wifi.conf "$(printf '[connection]\nwifi.powersave = 2')" \
  systemctl reload NetworkManager

[[ "${1:-}" == "--nu" ]] || sleep $((RANDOM % 60))

case "$(uname -m)" in
  i?86) ARCH=386 ;;
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv6l) ARCH=arm ;;
  *) echo "Unknown processor $(uname -m)"; exit 1 ;;
esac

AUTH=()
[[ -n "$GITHUB_TOKEN" ]] && AUTH=(-H "Authorization: Bearer $GITHUB_TOKEN")

if [[ "$KANAAL" == "stable" ]]; then
  API="https://api.github.com/repos/$REPO/releases/latest"
else
  API="https://api.github.com/repos/$REPO/releases?per_page=20"
fi
INFO="$(curl -fsSL "${AUTH[@]}" -H "Accept: application/vnd.github+json" "$API")" || { echo "GitHub not reachable"; exit 0; }
# test channel: newest release of the app itself (the librespot releases are not app versions)
[[ "$KANAAL" == "stable" ]] || INFO="$(jq '[.[] | select(.tag_name | startswith("v"))][0]' <<<"$INFO")"

VERSIE="$(jq -r '.tag_name' <<<"$INFO")"
[[ -n "$VERSIE" && "$VERSIE" != "null" ]] || { echo "No release found"; exit 0; }

HUIDIG="$(readlink -f /opt/unscroll/huidig 2>/dev/null | xargs -r basename || true)"
if [[ "$HUIDIG" == "$VERSIE" ]]; then
  echo "Already up to date ($VERSIE)"; exit 0
fi

asset_url() { jq -r --arg n "$1" '.assets[] | select(.name==$n) | .url' <<<"$INFO"; }
BIN_URL="$(asset_url "unscroll-linux-$ARCH")"
SUM_URL="$(asset_url "unscroll-linux-$ARCH.sha256")"
[[ -n "$BIN_URL" && -n "$SUM_URL" ]] || { echo "Release $VERSIE has no file for $ARCH"; exit 1; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
haal() { curl -fsSL "${AUTH[@]}" -H "Accept: application/octet-stream" -o "$2" "$1"; }
haal "$BIN_URL" "$TMP/unscroll"
haal "$SUM_URL" "$TMP/unscroll.sha256"

VERWACHT="$(awk '{print $1}' "$TMP/unscroll.sha256")"
GEMETEN="$(sha256sum "$TMP/unscroll" | awk '{print $1}')"
[[ "$VERWACHT" == "$GEMETEN" ]] || { echo "Checksum mismatch, update aborted"; exit 1; }

chmod 0755 "$TMP/unscroll"
"$TMP/unscroll" --version >/dev/null || { echo "New version does not start, update aborted"; exit 1; }

install -d "/opt/unscroll/releases/$VERSIE"
install -m 0755 "$TMP/unscroll" "/opt/unscroll/releases/$VERSIE/unscroll"
[[ -n "$HUIDIG" ]] && ln -sfn "/opt/unscroll/releases/$HUIDIG" /opt/unscroll/vorige
ln -sfn "/opt/unscroll/releases/$VERSIE" /opt/unscroll/huidig.nieuw
mv -Tf /opt/unscroll/huidig.nieuw /opt/unscroll/huidig
ln -sfn /opt/unscroll/huidig/unscroll /usr/local/bin/unscroll

# The scripts come in a separate, checksummed package. Optional: if anything is off,
# the old scripts simply stay.
TAR_URL="$(asset_url unscroll-scripts.tar.gz)"
TSUM_URL="$(asset_url unscroll-scripts.tar.gz.sha256)"
if [[ -n "$TAR_URL" && -n "$TSUM_URL" ]] && haal "$TAR_URL" "$TMP/scripts.tgz" && haal "$TSUM_URL" "$TMP/scripts.sha256"; then
  if [[ "$(awk '{print $1}' "$TMP/scripts.sha256")" == "$(sha256sum "$TMP/scripts.tgz" | awk '{print $1}')" ]] \
     && mkdir -p "$TMP/s" && tar -xzf "$TMP/scripts.tgz" --no-same-owner -C "$TMP/s" \
     && bash -n "$TMP/s/unscroll-sessie" && bash -n "$TMP/s/unscroll-update" && bash -n "$TMP/s/unscroll-ouder"; then
    install -m 0755 "$TMP/s/unscroll-sessie" /usr/local/bin/unscroll-sessie
    install -m 0755 "$TMP/s/unscroll-ouder" /usr/local/sbin/unscroll-ouder
    install -m 0755 "$TMP/s/unscroll-update" /usr/local/sbin/unscroll-update
    echo "Scripts updated."
  else
    echo "Scripts package not valid, keeping the current scripts."
  fi
fi

# librespot (the Spotify speaker) comes along when the release has it for this processor.
LR_URL="$(asset_url "librespot-linux-$ARCH")"
LR_SUM_URL="$(asset_url "librespot-linux-$ARCH.sha256")"
if [[ -n "$LR_URL" && -n "$LR_SUM_URL" ]] && haal "$LR_SUM_URL" "$TMP/librespot.sha256"; then
  WIL="$(awk '{print $1}' "$TMP/librespot.sha256")"
  HEB="$(sha256sum /usr/local/bin/librespot 2>/dev/null | awk '{print $1}' || true)"
  if [[ "$WIL" != "$HEB" ]]; then
    if haal "$LR_URL" "$TMP/librespot" && [[ "$(sha256sum "$TMP/librespot" | awk '{print $1}')" == "$WIL" ]] \
       && chmod 0755 "$TMP/librespot" && "$TMP/librespot" --version >/dev/null 2>&1; then
      install -m 0755 "$TMP/librespot" /usr/local/bin/librespot
      echo "librespot updated."
    else
      echo "librespot package not valid, keeping the current one."
    fi
  fi
fi

# Hedy (programming): one package for every processor, plus Python and its regex module from Debian.
HEDY_URL="$(asset_url unscroll-hedy.tar.gz)"
HEDY_SUM_URL="$(asset_url unscroll-hedy.tar.gz.sha256)"
if [[ -n "$HEDY_URL" && -n "$HEDY_SUM_URL" ]] && haal "$HEDY_SUM_URL" "$TMP/hedy.sha256"; then
  WIL="$(awk '{print $1}' "$TMP/hedy.sha256")"
  if [[ "$WIL" != "$(cat /opt/unscroll/hedy/.sha256 2>/dev/null)" ]]; then
    if haal "$HEDY_URL" "$TMP/hedy.tgz" && [[ "$(sha256sum "$TMP/hedy.tgz" | awk '{print $1}')" == "$WIL" ]]; then
      rm -rf /opt/unscroll/hedy.nieuw && mkdir -p /opt/unscroll/hedy.nieuw
      tar -xzf "$TMP/hedy.tgz" --no-same-owner -C /opt/unscroll/hedy.nieuw
      chmod -R a+rX /opt/unscroll/hedy.nieuw
      echo "$WIL" > /opt/unscroll/hedy.nieuw/.sha256
      rm -rf /opt/unscroll/hedy.oud
      [[ -d /opt/unscroll/hedy ]] && mv /opt/unscroll/hedy /opt/unscroll/hedy.oud
      mv /opt/unscroll/hedy.nieuw /opt/unscroll/hedy && rm -rf /opt/unscroll/hedy.oud
      echo "Hedy updated."
    else
      echo "Hedy package not valid, keeping the current one."
    fi
  fi
  for pakket in python3 python3-regex; do
    dpkg -s "$pakket" >/dev/null 2>&1 && continue
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$pakket" >/dev/null 2>&1 \
      || { apt-get update -q >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$pakket" >/dev/null 2>&1; } \
      || echo "Could not install $pakket (no internet?)"
  done
fi

# keep only the three most recent versions
find /opt/unscroll/releases -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | tail -n +4 | cut -d' ' -f2- | xargs -r rm -rf

echo "Updated to $VERSIE. Active after the next restart of the app."
