#!/usr/bin/env bash
# Parent helper: sets the PIN, quiet time and all secrets LOCALLY.
# None of this ever goes into git: everything lives only in /etc/unscroll on this device.
#
# Usage:  sudo unscroll-ouder
set -euo pipefail
umask 077   # new files (such as the secrets) are only readable by root until the end

DIR=/etc/unscroll
OUDERS=$DIR/ouders.yaml
GEHEIM=$DIR/geheimen.env
KIND="${KIND:-kind}"

[[ $EUID -eq 0 ]] || { echo "Run this as root: sudo unscroll-ouder"; exit 1; }
[[ -f $OUDERS ]] || { echo "$OUDERS does not exist. Run install.sh first."; exit 1; }

vraag() {        # vraag "question" "default" -> answer
  local a; read -r -p "$1 [$2]: " a; echo "${a:-$2}"
}
geheim() {       # geheim "question" -> answer, not shown on screen
  local a; read -r -s -p "$1 (empty = keep current): " a; echo >&2; echo "$a"
}
yaml_tekst() {   # yes/no and numbers stay bare, everything else gets quotes
  if [[ $1 =~ ^(true|false|[0-9]+)$ ]]; then printf '%s' "$1"; else printf '"%s"' "$1"; fi
}
zet_yaml() {     # zet_yaml key value  (single-line keys only)
  sed -i -E "s|^([[:space:]]*$1:).*|\1 $(yaml_tekst "$2")|" "$OUDERS"
}
zet_env() {      # zet_env NAME value  (in single quotes, so both bash and the app can read it)
  local naam=$1 waarde=$2 q="'\\''"
  [[ -z $waarde ]] && return
  touch "$GEHEIM"
  grep -v "^${naam}=" "$GEHEIM" > "$GEHEIM.tmp" || true
  printf "%s='%s'\n" "$naam" "${waarde//\'/$q}" >> "$GEHEIM.tmp"
  mv "$GEHEIM.tmp" "$GEHEIM"
}
yaml_waarde() {  # yaml_waarde key -> current value in ouders.yaml (first match, without quotes)
  sed -nE "s/^[[:space:]]*$1:[[:space:]]*\"?([^\"#]*)\"?.*/\1/p" "$OUDERS" | head -n 1 | sed 's/[[:space:]]*$//'
}
zet_yaml_in() {  # zet_yaml_in section key value  (adds the line under the section when it is missing)
  if grep -qE "^[[:space:]]+$2:" "$OUDERS"; then
    zet_yaml "$2" "$3"
  elif grep -q "^$1:" "$OUDERS"; then
    sed -i "/^$1:/a\\  $2: $(yaml_tekst "$3")" "$OUDERS"
  else
    printf '\n%s:\n  %s: %s\n' "$1" "$2" "$(yaml_tekst "$3")" >> "$OUDERS"
  fi
}
koppel_librespot() {  # links the Spotify speaker on this computer to an account, once
  local cache="/home/$KIND/.cache/unscroll/librespot"
  if ! command -v librespot >/dev/null; then
    echo "The Spotify speaker (librespot) is not installed yet. It comes with the next update;"
    echo "run sudo unscroll-update --nu and then this helper again."
    return 0
  fi
  install -d -o "$KIND" -g "$KIND" "/home/$KIND/.cache" "/home/$KIND/.cache/unscroll" "$cache"
  chown "$KIND:$KIND" "/home/$KIND/.cache" "/home/$KIND/.cache/unscroll" "$cache"
  rm -f "$cache/credentials.json"
  echo "Open the link below on a phone or computer and log in with the SAME Spotify account."
  echo "You end up on a page that does not load (127.0.0.1). Copy that whole address and paste it here."
  # librespot keeps running after the login; stop it as soon as the login is saved
  ( for _ in $(seq 1 900); do
      if [[ -s "$cache/credentials.json" ]]; then sleep 2; pkill -u "$KIND" -f "librespot.*enable-oauth"; exit 0; fi
      sleep 1
    done ) &
  sudo -u "$KIND" librespot --enable-oauth --cache "$cache" --disable-audio-cache --disable-discovery \
    --backend alsa --name "Unscroll-setup" --quiet || true
  wait
  if [[ -s "$cache/credentials.json" ]]; then echo "Spotify speaker linked."; else echo "Linking did not work, try again later."; fi
}
huidig() {       # huidig NAME -> current value from the secrets file (for addresses and user names)
  [[ -f $GEHEIM ]] || return 0
  # shellcheck source=/dev/null
  ( set +u; . "$GEHEIM"; printf '%s' "${!1:-}" )
}

# repair: older versions of this helper wrote yes/no values in quotes
sed -i -E 's/^([[:space:]]+[a-z_]+:) "(true|false)"/\1 \2/' "$OUDERS"

echo "== Unscroll parent helper =="
echo "Everything you enter here stays on this device."
echo

echo "-- PIN for parent mode --"
while true; do
  read -r -s -p "New PIN (4 to 8 digits, empty = keep current): " p1; echo
  [[ -z $p1 ]] && break
  [[ $p1 =~ ^[0-9]{4,8}$ ]] || { echo "Digits only, 4 to 8 of them."; continue; }
  read -r -s -p "Once more: " p2; echo
  [[ $p1 == "$p2" ]] || { echo "Not the same, try again."; continue; }
  zet_yaml pin_sha256 "$(/usr/local/bin/unscroll --pin-hash "$p1")"
  echo "PIN saved."
  break
done
echo

echo "-- Quiet time --"
zet_yaml schooldagen "$(vraag 'Closes on school nights (Sun to Thu)' "$(yaml_waarde schooldagen)")"
zet_yaml weekend "$(vraag 'Closes on Friday and Saturday evening' "$(yaml_waarde weekend)")"
zet_yaml open "$(vraag 'Opens again at' "$(yaml_waarde open)")"
echo

echo "-- Ask for help via ntfy (notification on your phones) --"
echo "Pick a long, hard to guess topic and subscribe to it in the ntfy app."
topic="$(yaml_waarde topic)"
[[ -n $topic ]] || topic="unscroll-$(tr -dc a-z0-9 </dev/urandom | head -c 12)"
topic=$(vraag "ntfy topic" "$topic")
zet_yaml topic "$topic"
echo

echo "-- Secrets (stored in $GEHEIM) --"
zet_env GITHUB_TOKEN "$(geheim 'GitHub token, only needed if the repository is private')"
echo
echo "Music: Navidrome. Give the child its own Navidrome user. Leave empty to skip."
zet_env NAVIDROME_URL "$(vraag 'Navidrome address, for example http://192.168.1.10:4533' "$(huidig NAVIDROME_URL)")"
zet_env NAVIDROME_GEBRUIKER "$(vraag 'Navidrome user for the child' "$(huidig NAVIDROME_GEBRUIKER)")"
zet_env NAVIDROME_WACHTWOORD "$(geheim 'Navidrome password')"
echo
echo "Audiobooks and podcasts: Audiobookshelf. Use the child's own account, so the progress is theirs."
echo "Find the key in Audiobookshelf: Settings > Users > (child) > API token, or Settings > API Keys."
zet_env ABS_URL "$(vraag 'Audiobookshelf address, for example http://192.168.1.10:13378' "$(huidig ABS_URL)")"
zet_env ABS_TOKEN "$(geheim 'Audiobookshelf API token or API key of the child account')"
echo
echo "AI buddy: create an API key at https://console.anthropic.com and set a monthly spend limit there."
echo "Limits per day are in $OUDERS (section maatje)."
zet_env ANTHROPIC_API_KEY "$(geheim 'Anthropic API key for the AI buddy')"
echo
echo "Which model should the buddy use?"
echo "  1) claude-haiku-5-5   cheapest (a few cents a day), fine for questions, quizzing and stories"
echo "  2) claude-sonnet-5-5  in between, a better homework coach"
echo "  3) claude-opus-5-5    best and most expensive"
case "$(yaml_waarde model)" in
  claude-haiku*) nu=1 ;; claude-sonnet*) nu=2 ;; *) nu=3 ;;
esac
case "$(vraag 'Choose 1, 2 or 3' "$nu")" in
  1) zet_yaml_in maatje model claude-haiku-5-5 ;;
  2) zet_yaml_in maatje model claude-sonnet-5-5 ;;
  3) zet_yaml_in maatje model claude-opus-5-5 ;;
  *) echo "Unknown choice, model unchanged." ;;
esac
echo

echo "-- Spotify (needs Premium; press Enter to skip) --"
echo "Spotify plays only the albums and playlists you approve, without autoplay or recommendations."
echo "Once: create an app at https://developer.spotify.com/dashboard (Web API), with redirect URI"
echo "  http://127.0.0.1:8898/callback"
echo "and copy its Client ID."
spid=$(vraag "Spotify Client ID" "$(huidig SPOTIFY_CLIENT_ID)")
if [[ -n $spid ]]; then
  zet_env SPOTIFY_CLIENT_ID "$spid"
  if [[ "$(vraag 'Log in to Spotify now (needed once)? y/n' n)" == y ]]; then
    if tok=$(/usr/local/bin/unscroll --spotify-login "$spid"); then
      zet_env SPOTIFY_REFRESH_TOKEN "$tok"
      echo "Logged in."
    fi
  fi
  if [[ "$(vraag 'Link the Spotify speaker on this computer now (needed once)? y/n' n)" == y ]]; then
    koppel_librespot
  fi
  case "$(yaml_waarde zoeken)" in true) nu=y ;; *) nu=n ;; esac
  if [[ "$(vraag 'May the child search artists and albums and keep favourites? y/n' "$nu")" == y ]]; then
    zet_yaml_in spotify zoeken true
  else
    zet_yaml_in spotify zoeken false
  fi
  echo "Approve albums and playlists by adding their Spotify links under spotify: goedgekeurd: in $OUDERS"
  echo "Block artists or albums under spotify: geblokkeerd: (links or artist names)."
fi

chown root:root "$OUDERS"; chmod 0644 "$OUDERS"
[[ -f $GEHEIM ]] && { chown root:"$KIND" "$GEHEIM"; chmod 0640 "$GEHEIM"; }

echo
echo "Done. Restart the app or the device to load everything: sudo reboot"
