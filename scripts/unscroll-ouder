#!/usr/bin/env bash
# Parent helper: sets the PIN, quiet time and all secrets LOCALLY.
# None of this ever goes into git: everything lives only in /etc/unscroll on this device.
#
# Usage:  sudo unscroll-ouder
set -euo pipefail

DIR=/etc/unscroll
OUDERS=$DIR/ouders.yaml
GEHEIM=$DIR/geheimen.env
KIND="${KIND:-kind}"

[[ $EUID -eq 0 ]] || { echo "Run this as root: sudo unscroll-ouder"; exit 1; }
[[ -f $OUDERS ]] || { echo "$OUDERS does not exist. Run install.sh first."; exit 1; }

vraag() {        # vraag "question" "default" -> answer
  local a; read -r -p "$1 [$2]: " a; echo "${a:-$2}"
}
geheim() {       # geheim "question" -> answer, not shown on screen
  local a; read -r -s -p "$1 (empty = keep current): " a; echo >&2; echo "$a"
}
zet_yaml() {     # zet_yaml key value  (single-line keys only)
  sed -i -E "s|^([[:space:]]*$1:).*|\1 \"$2\"|" "$OUDERS"
}
zet_env() {      # zet_env NAME value
  local naam=$1 waarde=$2
  [[ -z $waarde ]] && return
  touch "$GEHEIM"
  grep -v "^${naam}=" "$GEHEIM" > "$GEHEIM.tmp" || true
  printf '%s=%q\n' "$naam" "$waarde" >> "$GEHEIM.tmp"
  mv "$GEHEIM.tmp" "$GEHEIM"
}

echo "== Unscroll parent helper =="
echo "Everything you enter here stays on this device."
echo

echo "-- PIN for parent mode --"
while true; do
  read -r -s -p "New PIN (4 to 8 digits, empty = keep current): " p1; echo
  [[ -z $p1 ]] && break
  [[ $p1 =~ ^[0-9]{4,8}$ ]] || { echo "Digits only, 4 to 8 of them."; continue; }
  read -r -s -p "Once more: " p2; echo
  [[ $p1 == "$p2" ]] || { echo "Not the same, try again."; continue; }
  zet_yaml pin_sha256 "$(/usr/local/bin/unscroll --pin-hash "$p1")"
  echo "PIN saved."
  break
done
echo

echo "-- Quiet time --"
zet_yaml schooldagen "$(vraag 'Closes on school nights (Sun to Thu)' 20:00)"
zet_yaml weekend "$(vraag 'Closes on Friday and Saturday evening' 20:30)"
zet_yaml open "$(vraag 'Opens again at' 07:00)"
echo

echo "-- Ask for help via ntfy (notification on your phones) --"
echo "Pick a long, hard to guess topic and subscribe to it in the ntfy app."
topic=$(vraag "ntfy topic" "unscroll-$(tr -dc a-z0-9 </dev/urandom | head -c 12)")
zet_yaml topic "$topic"
echo

echo "-- Secrets (stored in $GEHEIM) --"
zet_env GITHUB_TOKEN "$(geheim 'GitHub token, only needed if the repository is private')"
zet_env NAVIDROME_URL "$(vraag 'Navidrome address (needed later, may be empty)' '')"
zet_env NAVIDROME_GEBRUIKER "$(vraag 'Navidrome user for the child' '')"
zet_env NAVIDROME_WACHTWOORD "$(geheim 'Navidrome password')"
zet_env ABS_URL "$(vraag 'Audiobookshelf address (needed later, may be empty)' '')"
zet_env ABS_TOKEN "$(geheim 'Audiobookshelf API token of the child account')"
zet_env ANTHROPIC_API_KEY "$(geheim 'Anthropic API key for the AI buddy')"

chown root:root "$OUDERS"; chmod 0644 "$OUDERS"
[[ -f $GEHEIM ]] && { chown root:"$KIND" "$GEHEIM"; chmod 0640 "$GEHEIM"; }

echo
echo "Done. Restart the app or the device to load everything: sudo reboot"
