# Secrets only live on the device, never in the repository.
# Location on the device: /etc/unscroll/geheimen.env (root, readable by the app)
# Fill them in with: sudo unscroll-ouder

# Only needed if the repository is private: a fine-grained token with
# read-only access to "Contents" of this one repository.
GITHUB_TOKEN=""

# Music (Navidrome): the child's own Navidrome user.
NAVIDROME_URL=""
NAVIDROME_GEBRUIKER=""
NAVIDROME_WACHTWOORD=""

# Audiobooks and podcasts (Audiobookshelf): API token or API key of the child's account.
ABS_URL=""
ABS_TOKEN=""

# Used in later phases:
# SPOTIFY_CLIENT_ID=""
# ANTHROPIC_API_KEY=""
